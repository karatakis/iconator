# Copy to `.env.local` (gitignored) for personal overrides.
# dotenvy never overwrites variables that are already set, so
# `.env.local` wins over `.env`, which wins over the shell environment.

# Bind address. Default: 0.0.0.0 (the point is network access).
HOST=0.0.0.0

# Listen port. Default: 3000.
PORT=3000

# Log filter for env_logger (e.g. info, debug, iconator=trace).
# Default: info
RUST_LOG=info
